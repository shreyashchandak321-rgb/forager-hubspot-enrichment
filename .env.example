# Copy to .env locally; on Railway set these in the service Variables tab.
FORAGER_API_KEY=
FORAGER_ACCOUNT_ID=
FORAGER_BASE_URL=https://api-v2.forager.ai
HUBSPOT_ACCESS_TOKEN=
# Comma-separated job titles/keywords allowed through the contact-discovery filter.
TITLE_FILTER=CEO,CTO,Chief,Founder,VP,Vice President,Director,Head of,Manager
# Optional: shared secret you append to webhook URLs, e.g. /webhooks/company?key=...
WEBHOOK_SECRET=
